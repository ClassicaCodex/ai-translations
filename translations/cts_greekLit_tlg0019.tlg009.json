  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker113",
   "text": "Heracles"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.139",
   "text": "In a tiny little boat — about so big — an old man,"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.140",
   "text": "a ferryman, will take you across, for a fee of two obols."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker114",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.141",
   "text": "Whew,"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.182",
   "text": "this is the one he told me of — and I see a boat, too."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker145",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.183",
   "text": "By Poseidon, yes, and here is Charon himself."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker146",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.184",
   "text": "Hail, Charon! Hail, Charon! Hail, Charon!"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.287b",
   "text": "Go on ahead, then."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker210",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.288",
   "text": "Well now, by Zeus, I do see a huge beast."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker211",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.289",
   "text": "What sort?"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker212",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.289b",
   "text": "A terrible one. At any rate it turns into all sorts of things:"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.290",
   "text": "now an ox, now a mule, and now again a woman,"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.291",
   "text": "a real beauty."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker213",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.291b",
   "text": "Where is she? Come on, let me go for her."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker214",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.292",
   "text": "But she's no longer a woman — now she's a dog."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker215",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.293",
   "text": "Then it's Empusa."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker216",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.293b",
   "text": "At any rate it's blazing with fire,"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.294",
   "text": "the whole of its face."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker217",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.294b",
   "text": "And has it got a bronze leg?"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker218",
   "text": "Xanthias"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.295",
   "text": "By Poseidon, yes, and the other one's of cow dung,"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.296",
   "text": "rest assured."
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.speaker219",
   "text": "Dionysus"
  },
  {
   "ref": "urn:cts:greekLit:tlg0019.tlg009.perseus-grc2.296b",
   "text": "Where can I turn, then?"
  }
 ]
}